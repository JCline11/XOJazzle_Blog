<!doctype html>
<html lang="en">
<%- include('../partials/head') %>
<body>
  <div class="paper-grain" aria-hidden="true"></div>
  <%- include('../partials/header') %>

  <main id="main-content" tabindex="-1">
    <section id="home" class="hero section-wrap">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="eyebrow-line" aria-hidden="true"></span>
          <%= profile.siteName %>'s little corner
        </p>

        <h1>
          Welcome to my<br><em>cozy</em> corner<br>
          of the internet<span class="pink-dot" aria-hidden="true">.</span>
        </h1>

        <p class="hero-intro"><%= profile.heroText %></p>

        <div class="hero-actions">
          <a class="button button-primary" href="#latest">
            wander through <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href="#about">
            a little about me <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <%
        // Longer copy uses the expanding layout from the first render.
        const compactHeroContent = [
          [heroCollage.primary.caption, 30],
          [heroCollage.secondary.caption, 30],
          [heroCollage.journal.date, 20],
          [heroCollage.journal.text, 30],
          [heroCollage.journal.emphasis, 30]
        ].every(([text, limit]) =>
          Array.from(text.replace(/\s+/g, ' ').trim()).length <= limit
        );
      %>
      <div class="hero-visual">
      <div
        class="hero-collage <%= compactHeroContent ? 'hero-collage--overlap' : '' %>"
        aria-label="A scrapbook collage of books, movies, and coffee"
      >
        <div class="sunburst" aria-hidden="true"></div>
        <span class="sticker sticker-star" aria-hidden="true">✦</span>
        <span class="sticker sticker-flower" aria-hidden="true">✽</span>
        <span class="tape tape-hero" aria-hidden="true"></span>

        <figure class="polaroid polaroid-main">
          <img
            src="<%= heroCollage.primary.imageUrl %>"
            alt="<%= heroCollage.primary.altText %>"
            width="263"
            height="330"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          >
          <figcaption><%= heroCollage.primary.caption %></figcaption>
        </figure>

        <figure class="polaroid polaroid-small">
          <img
            src="<%= heroCollage.secondary.imageUrl %>"
            alt="<%= heroCollage.secondary.altText %>"
            width="138"
            height="145"
            loading="eager"
            decoding="async"
          >
          <figcaption><%= heroCollage.secondary.caption %></figcaption>
        </figure>

        <div class="journal-scrap">
          <span class="journal-date"><%= heroCollage.journal.date %></span>
          <p>
            <%= heroCollage.journal.text %><br>
            <strong><%= heroCollage.journal.emphasis %></strong>
          </p>
          <span class="journal-heart" aria-hidden="true">♡</span>
        </div>

        <span class="doodle doodle-curve" aria-hidden="true">〰</span>
      </div>
      </div>
    </section>

    <div class="divider" aria-hidden="true">
      <span>✦</span><span>♡</span><span>✦</span>
    </div>

    <section
      id="loving"
      class="section-wrap loving-section"
      aria-labelledby="loving-title"
    >
      <div class="section-heading centered-heading">
        <p class="eyebrow">from the current chapter</p>
        <h2 id="loving-title">Currently <em>loving</em></h2>
        <p class="section-subtitle">
          A few things keeping me company lately.
        </p>
      </div>

      <div class="loving-grid">
        <article class="love-card love-book">
          <p class="love-card-label">
            currently reading <span aria-hidden="true">♡</span>
          </p>

          <div class="love-content">
            <div class="book-cover">
              <img
                src="<%= currentlyLoving.reading.coverImageUrl %>"
                alt="<%= currentlyLoving.reading.coverAltText %>"
                width="126"
                height="162"
                loading="lazy"
                decoding="async"
              >
            </div>

            <div class="love-note">
              <h3><%= currentlyLoving.reading.title %></h3>
              <span class="hand-label">my note</span>
              <p><%= currentlyLoving.reading.note %></p>
            </div>
          </div>
        </article>

        <article class="love-card love-movie">
          <p class="love-card-label">
            currently watching <span aria-hidden="true">✦</span>
          </p>

          <div class="love-content">
            <div class="movie-poster">
              <img
                src="<%= currentlyLoving.watching.coverImageUrl %>"
                alt="<%= currentlyLoving.watching.coverAltText %>"
                width="132"
                height="168"
                loading="lazy"
                decoding="async"
              >
            </div>

            <div class="love-note">
              <h3><%= currentlyLoving.watching.title %></h3>
              <span class="hand-label">my note</span>
              <p><%= currentlyLoving.watching.note %></p>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section
      id="latest"
      class="section-wrap latest-section"
      aria-labelledby="latest-title"
    >
      <div class="section-heading heading-row">
        <div>
          <p class="eyebrow">fresh from the scrapbook</p>
          <h2 id="latest-title">Latest <em>little notes</em></h2>
          <p class="section-subtitle">
            A few recent notes. Explore every story by category.
          </p>
        </div>

        <nav class="filter-tabs" aria-label="Browse notes by category">
          <a class="filter" href="/categories/books">books</a>
          <a class="filter" href="/categories/movies">movies</a>
          <a class="filter" href="/categories/anime">anime</a>
          <a class="filter" href="/categories/tv">TV</a>
        </nav>
      </div>

      <div class="posts-grid">
        <% if (latestPosts.length === 0) { %>
          <div class="empty-posts">
            <p class="hand-label">nothing here just yet ♡</p>
            <p>New notes are being tucked into the scrapbook.</p>
          </div>
        <% } else { %>
          <% latestPosts.forEach((post, index) => { %>
            <%- include("../partials/postcard", {
              post,
              index,
              eager: false,
              headingLevel: 3
            }) %>
          <% }) %>
        <% } %>
      </div>
    </section>

    <section
      id="watchlist"
      class="watchlist-section"
      aria-labelledby="watchlist-title"
    >
      <div class="watchlist-inner section-wrap">
        <div class="watchlist-heading">
          <span class="stamp">RELEASE<br>RADAR</span>
          <p class="eyebrow">on my radar</p>
          <h2 id="watchlist-title">
            My most<br><em>anticipated releases</em>
          </h2>
          <p class="watchlist-intro">
            The books, movies, and shows I cannot wait to finally experience.
          </p>

          <div class="category-doodle" aria-hidden="true">
            <span>✦</span>
            <strong>watch<br>list</strong>
            <span>♡</span>
          </div>
        </div>

        <div class="watchlist-cards">
          <article class="watchlist-card entry-one">
            <div class="entry-meta">
              <strong>books</strong><span>next on the shelf</span>
            </div>
            <h3>Books</h3>
            <p><%= anticipatedReleases.books.text %></p>
            <span class="entry-scribble">turning the page soon ♡</span>
          </article>

          <article class="watchlist-card entry-two">
            <div class="entry-meta">
              <strong>movies</strong><span>save the date</span>
            </div>
            <h3>Movies</h3>
            <p><%= anticipatedReleases.movies.text %></p>
            <span class="entry-scribble">save me a seat ✦</span>
          </article>

          <article class="watchlist-card entry-three">
            <div class="entry-meta">
              <strong>tv</strong><span>coming up next</span>
            </div>
            <h3>TV</h3>
            <p><%= anticipatedReleases.tv.text %></p>
            <span class="entry-scribble">ready to binge ♡</span>
          </article>
        </div>
      </div>
    </section>

    <section
      id="about"
      class="about-section section-wrap"
      aria-labelledby="about-title"
    >
      <div class="about-photo">
        <span class="tape tape-about" aria-hidden="true"></span>
        <img
          src="<%= profile.profileImageUrl %>"
          alt="Portrait of <%= profile.siteName %>"
          width="600"
          height="570"
          loading="lazy"
          decoding="async"
        >
        <span class="photo-caption">hello, I’m XOJazzle ✿</span>
      </div>

      <div class="about-copy">
        <p class="eyebrow">a little introduction</p>
        <h2 id="about-title">
          Hi, I’m Jasmine.<br><em>Nice to meet you.</em>
        </h2>
        <p><%= profile.aboutContent %></p>
        <p>
          Pull up a chair, stay awhile, and tell me what you’re loving lately.
        </p>

        <% if (profile.contactEmail) { %>
          <a
            class="button button-secondary"
            href="mailto:<%= profile.contactEmail %>"
          >
            say hello <span aria-hidden="true">♡</span>
          </a>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
