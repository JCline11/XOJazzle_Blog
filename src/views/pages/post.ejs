<!doctype html>
<html lang="en">
<%- include('../partials/head') %>
<body>
  <div class="paper-grain" aria-hidden="true"></div>
  <%- include('../partials/header') %>

  <%
    const previewMode =
      typeof preview !== 'undefined' ? preview : null;

    const paragraphs = post.body
      .trim()
      .split(/\r\n|\r|\n/)
      .map(paragraph => paragraph.trim())
      .filter(Boolean);

    const pullQuote = post.pullQuote?.trim() ?? "";
    const quoteAfterIndex = Math.min(1, paragraphs.length - 1);
  %>

  <main id="main-content" tabindex="-1" class="simple-post-page">
    <% if (previewMode) { %>
      <aside class="editor-preview" aria-label="Saved post preview">
        <p class="hand-label">
          Saved <%= previewMode.status %> preview
        </p>
        <p>
          This shows the last saved version.
          Previewing does not change its publication status.
        </p>
        <a
          class="text-link"
          href="/admin/posts/<%= previewMode.id %>/edit"
        >back to editor <span aria-hidden="true">→</span></a>
      </aside>
    <% } %>

    <article>
      <header class="simple-post-header section-wrap">
        <a
          class="article-back-link"
          href="<%= previewMode ? '/admin/posts/' + previewMode.id + '/edit' : '/#latest' %>"
        >
          <span aria-hidden="true">←</span>
          <%= previewMode ? 'back to editor' : 'back to latest notes' %>
        </a>

        <div class="simple-post-title">
          <p class="eyebrow">
            <span class="eyebrow-line" aria-hidden="true"></span>
            <%= post.categoryLabel %> journal
          </p>

          <h1>
            <%= post.title %><span class="pink-dot" aria-hidden="true">.</span>
          </h1>

          <p class="simple-post-excerpt"><%= post.excerpt %></p>

          <div class="article-meta" aria-label="Post information">
            <span><%= post.publishedDate %></span>
            <span aria-hidden="true">✦</span>
            <span><%= post.readTime %> read</span>
            <span aria-hidden="true">✦</span>
            <span>by XOJazzle</span>
          </div>
        </div>

        <figure class="simple-post-cover">
          <span class="tape simple-post-tape" aria-hidden="true"></span>
          <img
            src="<%= post.featuredImageUrl %>"
            alt="<%= post.altText %>"
            width="600"
            height="900"
            loading="eager"
            decoding="async"
          >

          <% if (post.imageCaption) { %>
            <figcaption><%= post.imageCaption %></figcaption>
          <% } %>
        </figure>
      </header>

      <div class="simple-post-body section-wrap">
        <% paragraphs.forEach((paragraph, index) => { %>
          <p class="<%= index === 0 ? 'simple-post-opening' : '' %>"><%= paragraph %></p>

          <% if (pullQuote && index === quoteAfterIndex) { %>
            <blockquote class="simple-post-quote">
              <p><%= pullQuote %></p>
            </blockquote>
          <% } %>
        <% }) %>

        <% if (post.rating) { %>
          <aside class="simple-post-rating" aria-label="Post rating">
            <div>
              <p class="hand-label">the final verdict</p>
              <p
                class="simple-post-stars"
                aria-label="<%= post.rating %> out of five stars"
              ><%= '★'.repeat(post.rating) %><%= '☆'.repeat(5 - post.rating) %></p>
            </div>
            <p><%= post.ratingNote %></p>
          </aside>
        <% } %>

        <% if (post.closingNote) { %>
          <div class="simple-post-note">
            <span aria-hidden="true">♡</span>
            <p class="hand-label">one last little note</p>
            <p><%= post.closingNote %></p>
            <strong>xo, XOJazzle</strong>
          </div>
        <% } %>

        <a class="simple-post-home" href="/">
          keep wandering through the scrapbook
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </article>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>