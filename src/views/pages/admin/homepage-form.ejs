<!doctype html>
<html lang="en">
<%- include('../../partials/head') %>
<body>
  <div class="paper-grain" aria-hidden="true"></div>

  <header class="site-header">
    <a class="brand" href="/admin">
      <span class="brand-mark">✿</span>
      <span>XOJazzle<span class="brand-dot">.</span></span>
    </a>
    <p class="header-note">private studio <span>♡</span></p>
  </header>

  <main class="simple-post-page">
    <section
      class="simple-post-header section-wrap"
      aria-labelledby="homepage-form-title"
    >
      <a class="article-back-link" href="/admin">
        <span aria-hidden="true">←</span> dashboard
      </a>

      <div class="simple-post-title">
        <p class="eyebrow">homepage editor</p>
        <h1 id="homepage-form-title">
          Edit the <em>homepage</em>
        </h1>
      </div>
    </section>

    <section class="simple-post-body">
      <div class="simple-post-note">
        <% if (error) { %>
          <p id="form-error" role="alert"><%= error %></p>
        <% } %>

        <form
          method="post"
          action="/admin/homepage"
          <% if (error) { %>aria-describedby="form-error"<% } %>
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <fieldset>
            <legend>Site profile</legend>

            <p>
              <label for="siteName">Site name</label><br>
              <input id="siteName" name="siteName"
                value="<%= homepage.siteName %>" required>
            </p>

            <p>
              <label for="heroText">Hero introduction</label><br>
              <textarea id="heroText" name="heroText"
                rows="4" required><%= homepage.heroText %></textarea>
            </p>

            <p>
              <label for="aboutContent">About content</label><br>
              <textarea id="aboutContent" name="aboutContent"
                rows="7" required><%= homepage.aboutContent %></textarea>
            </p>

            <p>
              <label for="profileImageUrl">Profile image</label><br>
              <input id="profileImageUrl" name="profileImageUrl"
                value="<%= homepage.profileImageUrl %>" required>
            </p>

            <p>
              <label for="contactEmail">Contact email</label><br>
              <input id="contactEmail" name="contactEmail" type="email"
                value="<%= homepage.contactEmail %>">
            </p>

            <p>
              <label for="instagramUrl">Instagram URL</label><br>
              <input id="instagramUrl" name="instagramUrl" type="url"
                value="<%= homepage.instagramUrl %>" required>
            </p>

            <p>
              <label for="tiktokUrl">TikTok URL</label><br>
              <input id="tiktokUrl" name="tiktokUrl" type="url"
                value="<%= homepage.tiktokUrl %>" required>
            </p>

            <p>
              <label for="youtubeUrl">YouTube URL</label><br>
              <input id="youtubeUrl" name="youtubeUrl" type="url"
                value="<%= homepage.youtubeUrl %>" required>
            </p>
          </fieldset>

          <fieldset>
            <legend>Hero collage</legend>

            <p>
              <label for="heroPrimaryImageUrl">Primary image</label><br>
              <input id="heroPrimaryImageUrl" name="heroPrimaryImageUrl"
                value="<%= homepage.heroPrimaryImageUrl %>" required>
            </p>

            <p>
              <label for="heroPrimaryAltText">Primary alt text</label><br>
              <input id="heroPrimaryAltText" name="heroPrimaryAltText"
                value="<%= homepage.heroPrimaryAltText %>" required>
            </p>

            <p>
              <label for="heroPrimaryCaption">Primary caption</label><br>
              <input id="heroPrimaryCaption" name="heroPrimaryCaption"
                value="<%= homepage.heroPrimaryCaption %>" required>
            </p>

            <p>
              <label for="heroSecondaryImageUrl">Secondary image</label><br>
              <input id="heroSecondaryImageUrl" name="heroSecondaryImageUrl"
                value="<%= homepage.heroSecondaryImageUrl %>" required>
            </p>

            <p>
              <label for="heroSecondaryAltText">Secondary alt text</label><br>
              <input id="heroSecondaryAltText" name="heroSecondaryAltText"
                value="<%= homepage.heroSecondaryAltText %>" required>
            </p>

            <p>
              <label for="heroSecondaryCaption">Secondary caption</label><br>
              <input id="heroSecondaryCaption" name="heroSecondaryCaption"
                value="<%= homepage.heroSecondaryCaption %>" required>
            </p>

            <p>
              <label for="heroJournalDate">Journal date</label><br>
              <input id="heroJournalDate" name="heroJournalDate"
                value="<%= homepage.heroJournalDate %>" required>
            </p>

            <p>
              <label for="heroJournalText">Journal text</label><br>
              <textarea id="heroJournalText" name="heroJournalText"
                rows="3" required><%= homepage.heroJournalText %></textarea>
            </p>

            <p>
              <label for="heroJournalEmphasis">Journal emphasis</label><br>
              <input id="heroJournalEmphasis" name="heroJournalEmphasis"
                value="<%= homepage.heroJournalEmphasis %>" required>
            </p>
          </fieldset>

          <fieldset>
            <legend>Currently Reading</legend>

            <p>
              <label for="readingTitle">Title</label><br>
              <input id="readingTitle" name="readingTitle"
                value="<%= homepage.readingTitle %>" required>
            </p>

            <p>
              <label for="readingCoverImageUrl">Cover image</label><br>
              <input id="readingCoverImageUrl" name="readingCoverImageUrl"
                value="<%= homepage.readingCoverImageUrl %>" required>
            </p>

            <p>
              <label for="readingCoverAltText">Cover alt text</label><br>
              <input id="readingCoverAltText" name="readingCoverAltText"
                value="<%= homepage.readingCoverAltText %>" required>
            </p>

            <p>
              <label for="readingNote">Note</label><br>
              <textarea id="readingNote" name="readingNote"
                rows="4" required><%= homepage.readingNote %></textarea>
            </p>
          </fieldset>

          <fieldset>
            <legend>Currently Watching</legend>

            <p>
              <label for="watchingTitle">Title</label><br>
              <input id="watchingTitle" name="watchingTitle"
                value="<%= homepage.watchingTitle %>" required>
            </p>

            <p>
              <label for="watchingCoverImageUrl">Cover image</label><br>
              <input id="watchingCoverImageUrl" name="watchingCoverImageUrl"
                value="<%= homepage.watchingCoverImageUrl %>" required>
            </p>

            <p>
              <label for="watchingCoverAltText">Cover alt text</label><br>
              <input id="watchingCoverAltText" name="watchingCoverAltText"
                value="<%= homepage.watchingCoverAltText %>" required>
            </p>

            <p>
              <label for="watchingNote">Note</label><br>
              <textarea id="watchingNote" name="watchingNote"
                rows="4" required><%= homepage.watchingNote %></textarea>
            </p>
          </fieldset>

          <fieldset>
            <legend>Most anticipated releases</legend>

            <p>
              <label for="anticipatedBooks">Books</label><br>
              <textarea id="anticipatedBooks" name="anticipatedBooks"
                rows="4" required><%= homepage.anticipatedBooks %></textarea>
            </p>

            <p>
              <label for="anticipatedMovies">Movies</label><br>
              <textarea id="anticipatedMovies" name="anticipatedMovies"
                rows="4" required><%= homepage.anticipatedMovies %></textarea>
            </p>

            <p>
              <label for="anticipatedTv">TV</label><br>
              <textarea id="anticipatedTv" name="anticipatedTv"
                rows="4" required><%= homepage.anticipatedTv %></textarea>
            </p>
          </fieldset>

          <button class="button button-primary" type="submit">
            save homepage
          </button>
        </form>
      </div>
    </section>
  </main>
</body>
</html>