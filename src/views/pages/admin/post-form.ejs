<!doctype html>
<html lang="en">
<%- include('../../partials/head') %>
<body>
  <div class="paper-grain" aria-hidden="true"></div>

  <header class="site-header">
    <a class="brand" href="/admin">
      <span class="brand-mark">✿</span>
      <span>XOJazzle<span class="brand-dot">.</span></span>
    </a>
    <p class="header-note">private studio <span>♡</span></p>
  </header>

  <main class="simple-post-page">
    <section
      class="simple-post-header section-wrap"
      aria-labelledby="post-form-title"
    >
      <a class="article-back-link" href="/admin">
        <span aria-hidden="true">←</span> dashboard
      </a>

      <div class="simple-post-title">
        <p class="eyebrow">post editor</p>
        <h1 id="post-form-title"><%= heading %></h1>
      </div>
    </section>

    <section class="simple-post-body">
      <div class="simple-post-note">
        <% if (error) { %>
          <p id="form-error" role="alert"><%= error %></p>
          <p><a href="<%= action === '/admin/posts' ? '/admin/posts/new' : action + '/edit' %>">Reload the editor with the latest saved content</a> (discards unsaved entries).</p>
          <p>
            Your text entries are preserved.
            If you selected an image, choose it again before retrying.
          </p>
        <% } %>

        <form
          method="post"
          action="<%= action %>"
          enctype="multipart/form-data"
          <% if (error) { %>aria-describedby="form-error"<% } %>
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="postVersion" value="<%= postVersion %>">

          <p>
            <label for="title">Title</label><br>
            <input id="title" name="title"
              value="<%= post.title %>"
              maxlength="200" required>
          </p>

          <p>
            <label for="slug">Slug</label><br>
            <input id="slug" name="slug"
              value="<%= post.slug %>"
              maxlength="200"
              pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
              required>
          </p>

          <p>
            <label for="category">Category</label><br>
            <select id="category" name="category">
              <% ['BOOKS', 'MOVIES', 'ANIME', 'TV'].forEach((value) => { %>
                <option value="<%= value %>"
                  <%= post.category === value ? 'selected' : '' %>
                ><%= value.toLowerCase() %></option>
              <% }) %>
            </select>
          </p>

          <p>
            <label for="status">Publication status</label><br>
            <select id="status" name="status">
              <option value="DRAFT"
                <%= post.status === 'DRAFT' ? 'selected' : '' %>
              >draft</option>
              <option value="PUBLISHED"
                <%= post.status === 'PUBLISHED' ? 'selected' : '' %>
              >published</option>
            </select>
          </p>

          <p>
            <label for="excerpt">Excerpt</label><br>
            <textarea id="excerpt" name="excerpt"
              maxlength="500" rows="4"
              required><%= post.excerpt %></textarea>
          </p>

          <p>
            <label for="body">Body</label><br>
            <textarea id="body" name="body"
              maxlength="50000" rows="18"
              required><%= post.body %></textarea>
          </p>

          <% if (currentImageUrl) { %>
            <figure>
              <img
                src="<%= currentImageUrl %>"
                alt="<%= post.altText || 'Current featured image' %>"
                width="240"
              >
              <figcaption>Current featured image</figcaption>
            </figure>
          <% } %>

          <p>
            <label for="featuredImage">
              <%= currentImageUrl ? 'Replace featured image' : 'Featured image' %>
            </label><br>

            <input
              id="featuredImage"
              name="featuredImage"
              type="file"
              accept="<%= imageAccept %>"
              aria-describedby="featured-image-help"
              <% if (!currentImageUrl) { %>required<% } %>
            >
          </p>

          <p id="featured-image-help">
            JPEG, PNG, WebP, HEIC, or HEIF.
            Maximum 5 MiB and 25 million pixels.
            <% if (currentImageUrl) { %>
              Leave empty to keep the current image.
            <% } %>
          </p>

          <p>
            <label for="altText">Image alternative text</label><br>
            <input id="altText" name="altText"
              value="<%= post.altText %>"
              maxlength="300" required>
          </p>

          <p>
            <label for="imageCaption">Image caption</label><br>
            <input id="imageCaption" name="imageCaption"
              value="<%= post.imageCaption %>"
              maxlength="300">
          </p>

          <p>
            <label for="pullQuote">Pull quote</label><br>
            <textarea id="pullQuote" name="pullQuote"
              maxlength="1000" rows="3"
            ><%= post.pullQuote %></textarea>
          </p>

          <p>
            <label for="rating">Rating</label><br>
            <select id="rating" name="rating">
              <option value="">no rating</option>
              <% ['1', '2', '3', '4', '5'].forEach((value) => { %>
                <option value="<%= value %>"
                  <%= post.rating === value ? 'selected' : '' %>
                ><%= value %></option>
              <% }) %>
            </select>
          </p>

          <p>
            <label for="ratingNote">Rating note</label><br>
            <textarea id="ratingNote" name="ratingNote"
              maxlength="1000" rows="3"
            ><%= post.ratingNote %></textarea>
          </p>

          <p>
            <label for="closingNote">Closing note</label><br>
            <textarea id="closingNote" name="closingNote"
              maxlength="2000" rows="4"
            ><%= post.closingNote %></textarea>
          </p>

          <button class="button button-primary" type="submit">
            <%= submitLabel %>
          </button>
        </form>
      </div>
    </section>
  </main>
</body>
</html>
