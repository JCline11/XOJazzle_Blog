<!doctype html>
<html lang="en">
<%- include('../../partials/head', { adminStyles: true }) %>
<body class="admin-page admin-dashboard">
  <div class="paper-grain" aria-hidden="true"></div>

  <header class="site-header">
    <a
      class="brand"
      href="/"
      aria-label="Return to the XOJazzle homepage"
    >
      <span class="brand-mark">✿</span>
      <span>XOJazzle<span class="brand-dot">.</span></span>
    </a>
    <nav class="admin-nav" aria-label="Studio navigation">
      <a href="/admin">dashboard</a>
      <a href="/">view blog <span aria-hidden="true">↗</span></a>
    </nav>
    <p class="header-note">private studio <span>♡</span></p>
  </header>

  <main class="simple-post-page admin-main">
    <section
      class="simple-post-header section-wrap"
      aria-labelledby="dashboard-title"
    >
      <a class="article-back-link" href="/">
        <span aria-hidden="true">←</span> view the public blog
      </a>

      <div class="simple-post-title">
        <p class="eyebrow">administrator dashboard</p>
        <h1 id="dashboard-title">The private <em>studio</em></h1>
        <p class="simple-post-excerpt">
          Manage blog posts and homepage content.
        </p>
      </div>
    </section>

    <section class="simple-post-body" aria-labelledby="posts-title">
      <% if (notice) { %>
        <p class="admin-notice" role="status"><%= notice %></p>
      <% } %>

      <div class="simple-post-note admin-paper">
        <p class="hand-label">content tools</p>
        <h2 id="posts-title">Blog posts</h2>

        <p class="admin-toolbar">
          <a class="button button-primary" href="/admin/posts/new">
            create a post
          </a>
          <a class="button button-secondary" href="/admin/homepage">
            edit homepage
          </a>
        </p>

        <div
          class="admin-post-filters"
          data-post-filters
          role="group"
          aria-label="Filter blog posts"
          hidden
        >
          <p>
            <label for="post-status-filter">Publication status</label>
            <select id="post-status-filter" data-post-status>
              <option value="all">all statuses</option>
              <option value="draft">drafts</option>
              <option value="published">published</option>
            </select>
          </p>

          <p>
            <label for="post-category-filter">Category</label>
            <select id="post-category-filter" data-post-category>
              <option value="all">all categories</option>
              <option value="books">books</option>
              <option value="movies">movies</option>
              <option value="anime">anime</option>
              <option value="tv">TV shows</option>
            </select>
          </p>

          <div class="admin-filter-actions">
            <button
              class="button button-secondary"
              type="button"
              data-reset-post-filters
            >reset filters</button>
            <p data-post-count role="status" aria-live="polite"></p>
          </div>
        </div>

        <p data-post-filter-empty role="status" hidden>
          No posts match those filters.
          Try another category or reset the filters.
        </p>

        <% if (posts.length === 0) { %>
          <p>No posts have been created yet.</p>
        <% } else { %>
          <ul class="admin-post-list">
            <% posts.forEach((post) => { %>
              <li
                class="admin-post-row"
                data-post-row
                data-status="<%= post.status %>"
                data-category="<%= post.category %>"
              >
                <p class="admin-post-details">
                  <strong><%= post.title %></strong><br>
                  <span>
                    <span class="admin-status admin-status--<%= post.status %>"><%= post.status %></span>
                    <%= post.category %> · updated <%= post.updatedAt %>
                  </span>
                </p>

                <p class="admin-row-actions">
                  <a href="/admin/posts/<%= post.id %>/edit">edit</a>
                  ·
                  <a
                    href="/admin/posts/<%= post.id %>/preview"
                    target="_blank"
                    rel="noopener"
                  >preview saved</a>

                  <% if (post.status === "published") { %>
                    ·
                    <a href="/posts/<%= post.slug %>">view</a>
                  <% } %>

                  ·
                  <button
                    type="button"
                    class="admin-delete-trigger"
                    data-delete-dialog="delete-post-<%= post.id %>"
                    aria-haspopup="dialog"
                    aria-controls="delete-post-<%= post.id %>"
                    hidden
                  >delete</button>
                </p>

                <dialog
                  id="delete-post-<%= post.id %>"
                  class="delete-dialog"
                  aria-labelledby="delete-post-title-<%= post.id %>"
                  aria-describedby="delete-post-description-<%= post.id %>"
                >
                  <h2 id="delete-post-title-<%= post.id %>">
                    Delete this post?
                  </h2>
                  <p id="delete-post-description-<%= post.id %>">
                    Are you sure you want to delete:
                    <strong><%= post.title %></strong>?
                  </p>
                  <p>This permanently removes the post.</p>

                  <form
                    method="post"
                    action="/admin/posts/<%= post.id %>/delete"
                  >
                    <input
                      type="hidden"
                      name="_csrf"
                      value="<%= csrfToken %>"
                    >
                    <input
                      type="hidden"
                      name="postVersion"
                      value="<%= post.postVersion %>"
                    >
                    <input
                      type="hidden"
                      name="confirmDelete"
                      value="yes"
                    >

                    <div class="delete-dialog__actions">
                      <button
                        type="button"
                        class="button button-secondary"
                        data-cancel-delete
                        autofocus
                      >cancel</button>
                      <button
                        type="submit"
                        class="button button-primary delete-dialog__confirm"
                      >delete</button>
                    </div>
                  </form>
                </dialog>
              </li>
            <% }) %>
          </ul>
        <% } %>

        <noscript>
          <p>Enable JavaScript to use delete confirmation.</p>
        </noscript>

        <form
          class="admin-logout"
          method="post"
          action="/admin/logout"
        >
          <input
            type="hidden"
            name="_csrf"
            value="<%= csrfToken %>"
          >
          <button class="button button-secondary" type="submit">
            log out <span aria-hidden="true">♡</span>
          </button>
        </form>
      </div>
    </section>
  </main>

  <script src="/js/admin-delete.js" defer></script>
  <script src="/js/admin-dashboard.js" defer></script>
</body>
</html>