DATABASE_URL="postgresql://postgres:password@localhost:5432/xojazzle"
SESSION_SECRET=""
PORT=3000
NODE_ENV="development"

# Server-only R2 configuration.
# Use a dedicated development bucket while building this milestone.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="xojazzle-images-dev"

# HTTPS public delivery origin without a trailing slash.
# Development: the bucket's actual public https://pub-....r2.dev URL.
# Production: your connected custom domain.
# Do not use the authenticated r2.cloudflarestorage.com API endpoint.
R2_PUBLIC_BASE_URL=""

# Set these only while running npm run admin:set-password.
# Never commit real administrator credentials.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""